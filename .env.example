# Variáveis de ambiente do Firebase
# Copie este arquivo para .env.local e preencha com as credenciais reais do seu projeto Firebase
# NUNCA envie o arquivo .env.local para o GitHub

# Obtenha essas informações em:
# Firebase Console > Configurações do Projeto > Seus aplicativos > Web > Configuração do SDK

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu_projeto_id
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
